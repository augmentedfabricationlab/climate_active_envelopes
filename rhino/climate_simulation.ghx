                            <item name="Description" type_name="gh_string" type_code="10">Optional legend parameters from the "LB Legend Parameters"
that will be used to customize the display of the results.</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">792399b7-e760-472c-9ed2-3cfb823e4b57</item>
                            <item name="Locked" type_name="gh_bool" type_code="1">true</item>
